\newlabel{prop:two-channel}{{4.2}{9}{Invariance and reduced flow; exact}{theorem.4.2}{}}
\newlabel{eq:reduced-loss}{{4.4}{9}{Invariance and reduced flow; exact}{equation.4.4}{}}

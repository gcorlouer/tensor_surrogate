\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The two-channel manifold. Shaded cores form the Steiner subtree $S$ of $V_r$: (a) $V_r$ consists of the leaves of sites $0$ and $1$, and $S$ adds their parent, which has no site; (b) $V_r=\{1,3\}$, and $S$ adds core $2$, which carries a site on which $r$ agrees with $j$. The learned channel uses index $0$ on every edge; the dormant channel uses index $1$ on the edges of $S$ (thick) and index $0$ on the edges that leave $S$ (dashed), where it shares the cores of the learned channel. On a dashed edge balance reads $a^2=x^2+b^2$.}}{9}{figure.1}\protected@file@percent }
\newlabel{fig:two-channel}{{1}{9}{The two-channel manifold. Shaded cores form the Steiner subtree $S$ of $V_r$: (a) $V_r$ consists of the leaves of sites $0$ and $1$, and $S$ adds their parent, which has no site; (b) $V_r=\{1,3\}$, and $S$ adds core $2$, which carries a site on which $r$ agrees with $j$. The learned channel uses index $0$ on every edge; the dormant channel uses index $1$ on the edges of $S$ (thick) and index $0$ on the edges that leave $S$ (dashed), where it shares the cores of the learned channel. On a dashed edge balance reads $a^2=x^2+b^2$}{figure.1}{}}
\newlabel{eq:W-two-channel}{{4.2}{9}{An exact reduction: the two-channel manifold}{equation.4.2}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Comparing a student with a TTN teacher. (a) Cutting the bond $e$ splits the teacher into the subtree below $e$ (blue), which computes the left factors $\phi ^\star _{e,q}$ of the inputs $x^{(1)},x^{(2)}$, and its environment (orange), which computes the right factors $\psi ^\star _{e,q}$ of $x^{(3)},x^{(4)}$. An atom is the product of two such factors, weighted by a singular value of the data-weighted HSVD (Sections~\ref {sec:dw-hsvd} and~\ref {sec:atoms}). (b) For a student, one asks whether its output contains the atom (Section~\ref {sec:output-obs}), whether the factors and the atom can be read off a hidden layer, here $h_2$ (Section~\ref {sec:representation}), and whether the layers above use and rely on that code (Section~\ref {sec:use}).}}{24}{figure.3}\protected@file@percent }
\newlabel{fig:compare}{{3}{24}{Comparing a student with a TTN teacher. (a) Cutting the bond $e$ splits the teacher into the subtree below $e$ (blue), which computes the left factors $\phi ^\star _{e,q}$ of the inputs $x^{(1)},x^{(2)}$, and its environment (orange), which computes the right factors $\psi ^\star _{e,q}$ of $x^{(3)},x^{(4)}$. An atom is the product of two such factors, weighted by a singular value of the data-weighted HSVD (Sections~\ref {sec:dw-hsvd} and~\ref {sec:atoms}). (b) For a student, one asks whether its output contains the atom (Section~\ref {sec:output-obs}), whether the factors and the atom can be read off a hidden layer, here $h_2$ (Section~\ref {sec:representation}), and whether the layers above use and rely on that code (Section~\ref {sec:use})}{figure.3}{}}
\newlabel{eq:gram}{{4.2}{24}{Data}{equation.4.2}{}}
\newlabel{eq:independent-blocks}{{4.3}{24}{Data}{equation.4.3}{}}
